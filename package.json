{
  "name": "prism9-edge-native",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:wasm": "cd src/wasm && wasm-pack build --target web --release && cd ../.. && node scripts/copy-wasm.mjs",
    "build:all": "npm run build:wasm && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .js,.jsx,.ts,.tsx",
    "deploy": "npm run build:all && wrangler deploy --env production"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^3.95.0"
  },
  "engines": {
    "node": ">=18"
  }
}
